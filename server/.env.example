# ============================================
# Supabase Configuration (PostgreSQL)
# Get credentials from: https://supabase.com/dashboard/projects
# ============================================
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...your-api-key-here
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...service-role-key-here
DATABASE_URL=postgresql://postgres:password@db.your-project-id.supabase.co:5432/postgres

# ============================================
# Server Configuration
# ============================================
PORT=8000
NODE_ENV=development

# ============================================
# JWT Configuration (REQUIRED - Change for production)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ============================================
JWT_SECRET=your_jwt_secret_key_here_min_32_characters
JWT_EXPIRE=7d

# ============================================
# Email Configuration (Brevo REST API)
# Free tier: 300 emails/day
# Get API key: https://www.brevo.com/ → SMTP & API
# ============================================
BREVO_API_KEY=xkeysib-your-api-key-here
EMAIL_FROM=your-verified-sender-email@domain.com

# ============================================
# AI/Chatbot Configuration (Google Gemini)
# Get API key: https://ai.google.dev/ → Get API key
# Models: gemini-2.5-flash (free tier)
# ============================================
GEMINI_API_KEY=your-gemini-api-key-here

# ============================================
# CORS Configuration
# ============================================
# Comma-separated list of allowed origins for production
# Development: http://localhost:3000,http://localhost:5173
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ============================================
# Rate Limiting (optional)
# ============================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX_REQUESTS=10

# ============================================
# Logging
# ============================================
LOG_LEVEL=info
